# ===== Environment guard (D-016) =====
# local | test | production. Vercel Production must be "production", Vercel Preview must be "test", .env.local must be "local".
APP_ENV=

# ===== Supabase (server-only; never expose to the browser) =====
# Project URL (https://<project-ref>.supabase.co). The dev/test project and the production project are DIFFERENT projects.
SUPABASE_URL=
# Publishable key (new format) or anon key (legacy). Used only server-side.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (new format) or service_role key (legacy). Server-only. Full privilege. Never log or commit.
SUPABASE_SECRET_KEY=
# Runtime DB connection: Supavisor TRANSACTION pooler (port 6543), role app_runtime. postgres.js with prepare:false.
DATABASE_URL=
# Migration DB connection: Supavisor SESSION pooler (port 5432). Local / CI only. Do NOT set on Vercel.
DATABASE_URL_MIGRATION=

# ===== Origins (two different hosts; no trailing slash) =====
# Local example: APP_ORIGIN=http://localhost:3000  CONTENT_ORIGIN=http://127.0.0.1:3000
APP_ORIGIN=
CONTENT_ORIGIN=

# ===== Cron =====
# Random string, 32+ chars. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to cron paths.
CRON_SECRET=

# ===== Optional tunables (defaults in src/server/config.ts; leave empty to use defaults) =====
STORAGE_BUCKET=            # default: files
MAX_FILE_SIZE_MB=          # default: 50
USER_QUOTA_MB=             # default: 900
TOTAL_QUOTA_MB=            # default: 900
EGRESS_MONTHLY_LIMIT_GB=   # default: 5
INVITE_TTL_HOURS=          # default: 72
RESET_TTL_HOURS=           # default: 24
SHARE_LINK_DEFAULT_DAYS=   # default: 7
SHARE_LINK_MAX_DAYS=       # default: 90
VIEW_TICKET_TTL_SEC=       # default: 60
DOWNLOAD_TICKET_TTL_SEC=   # default: 600
SESSION_MAX_AGE_DAYS=      # default: 7
EXPIRED_FILE_RETENTION_DAYS= # default: 30
ACCESS_LOG_RETENTION_DAYS= # default: 180
AUDIT_LOG_RETENTION_DAYS=  # default: 365
LOG_LEVEL=                 # default: info (debug | info | warn | error)

# ===== Conditional =====
# Only if the alternative in 02 5.1.4 is adopted (HMAC-signed cookie for authentication time). 32+ chars.
APP_COOKIE_SECRET=

# ===== E2E (local / test only) =====
E2E_BASE_URL=              # e.g. http://localhost:3000
E2E_CONTENT_URL=           # e.g. http://127.0.0.1:3000
E2E_ALLOWED_HOSTS=         # comma separated hostnames of the TEST environment. Never production.

# ===== seed (local / test only; scripts/seed.ts, not read by src/server/config.ts) =====
SEED_PASSWORD=             # 12+ chars, shared by all seed accounts. Set in .env.local only
SEED_EXTRA_MEMBERS=        # optional, integer 0-19 (default 0). N creates seed-member-2..N+1 as seed-folder members (e.g. 4 for the k6 view-raw 5-member test). seed:cleanup always covers seed-member-2..20
