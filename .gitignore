# ===== 秘密情報・環境設定 =====
# .env.example 以外の .env 系はすべて除外（.env.local / .env.test 等を含む）
.env
.env.*
!.env.example
/auth.json
*.pem
*.key

# ===== 依存パッケージ =====
node_modules/

# ===== Next.js のビルド成果物 =====
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ===== Vercel / ローカルツール =====
.vercel/
.spike-*.tmp
.eslintcache

# ===== テスト・解析の出力（テストコードと設定ファイル自体はコミットする。CI が実行する） =====
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
# 性能測定の生データ（k6 の JSON、curl の CSV。tests/perf/README.md）
tests/perf/results/

# ===== 巨大な試験用 HTML（npm run gen:probe で生成。50MB 級のためコミットしない） =====
/e2e/assets/large-*.html

# ===== バックアップ（pg_dump の出力。暗号化済みでもコミットしない） =====
backups/
*.dump
*.dump.gpg
*.dump.enc
*.sql.gz

# ===== ローカル DB（使わない想定。念のため） =====
*.sqlite
*.sqlite-journal

# ===== ログ =====
*.log
npm-debug.log*

# ===== エディタ・IDE =====
.idea/
.vscode/*
!.vscode/extensions.json
.cursor/
.codex/
*.swp

# ===== エージェント設定・設計書・退避ファイル（ローカルのみで管理。GitHub に置かない） =====
/.claude
/docs
/_archive
/*.md

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini
