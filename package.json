{
  "name": "file-share",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "test:integration": "tsx scripts/guard-env.ts && vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/guard-env.ts && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/guard-env.ts && tsx scripts/seed.ts",
    "seed:cleanup": "tsx scripts/guard-env.ts && tsx scripts/seed-cleanup.ts",
    "gen:probe": "tsx scripts/gen-probe-html.ts",
    "env:show": "tsx scripts/show-env.ts",
    "verify-db": "tsx scripts/ops/verify-db.ts",
    "ops:reconcile": "tsx scripts/ops/reconcile.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "dotenv": "18.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "~9.39.5",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
